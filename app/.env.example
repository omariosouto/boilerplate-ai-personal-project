# Google OAuth client IDs (public values, safe for the client bundle).
# Create them at Google Auth Platform → Clients. Copy this file to .env.local and fill it in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# API key restricted to the Google Picker API + your site's origin (public, safe for the client bundle).
EXPO_PUBLIC_GOOGLE_PICKER_API_KEY=
# Project number (Google Cloud → project dashboard). Used as the Picker app ID.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
